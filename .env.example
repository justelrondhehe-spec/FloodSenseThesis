# Copy this file to .env (see README), then restart Expo with: npx expo start --clear
#
# This is the Supabase *publishable* key. It is meant to be public: what each user can read
# or write is controlled by the Row Level Security rules in supabase/*.sql.
# NEVER put the Supabase "secret" (service_role) key in this file or anywhere in the app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_jrYGOPsOEUKvXOZZDq9P2w_rFanTXYe
