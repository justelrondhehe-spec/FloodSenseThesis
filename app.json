{
  "expo": {
    "name": "FloodSense",
    "slug": "floodsense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.floodsense.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FloodSense uses your location to show where you are on the map and to find the safest walking route to an evacuation area."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.floodsense.app"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2EC4B6"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FloodSense uses your location to show where you are on the map and to find the safest walking route to an evacuation area.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "scheme": "floodsense",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ebe43adf-76f5-4035-a865-224d48584f1b"
      }
    }
  }
}
