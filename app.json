{
  "expo": {
    "name": "FloodSense",
    "slug": "floodsense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0D3B5E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.floodsense.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FloodSense uses your location to show where you are on the map and to find the safest walking route to an evacuation area."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D3B5E",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.floodsense.app"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#2EC4B6"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FloodSense uses your location to show where you are on the map and to find the safest walking route to an evacuation area.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "scheme": "floodsense",
    "experiments": {
      "typedRoutes": true
    }
  }
}
